{
  "name": "kracar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "npm run db:push",
    "seed:kracar": "tsx scripts/seed-kracar.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts e2e tests replica/design *.ts *.mjs *.json",
    "db:push": "tsx scripts/setup-kracar-db.ts",
    "jobs:kracar": "tsx scripts/kracar-jobs.ts",
    "postinstall": "prisma generate",
    "test:mongodb": "node --conditions=react-server --import tsx --test tests/integration/kracar-mongo.test.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.14",
    "lucide-react": "0.468.0",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server": "10.4.3",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
