MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=atlas_journeys
# Rental core uses the same MongoDB server and a separate database.
# The server must support transactions: use Atlas or a local replica set.
KRACAR_MONGODB_DB=kracar_core
# Optional: separate replica-set URI, including the rental database name.
# KRACAR_MONGODB_URI=mongodb://127.0.0.1:27017/kracar_core?replicaSet=rs0
APP_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
AGENCY_EMAIL=agency@example.com
AGENCY_PASSWORD=replace-with-a-different-strong-password
AGENCY_ID=agency-atlas
# Local sample accounts and data only. Never enable on a public deployment.
DEMO_MODE=true
